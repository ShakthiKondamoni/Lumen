{
  "name": "lumen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs web",
    "dev:web": "node scripts/dev.mjs web",
    "dev:server": "node scripts/dev.mjs server",
    "dev:desktop": "node scripts/dev.mjs desktop",
    "build:web": "node scripts/build-web.mjs",
    "package:win": "node scripts/build-web.mjs && pnpm --filter @lumen/desktop package:win",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "start": "node scripts/dev.mjs preview"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@hono/node-server": "^1.14.0",
    "@types/node": "22.13.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "eslint": "9.22.0",
    "globals": "16.0.0",
    "prettier": "3.5.3",
    "terser": "5.31.0",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "vite": "6.1.0",
    "vitest": "3.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@swc/core",
      "@tailwindcss/oxide"
    ]
  }
}
