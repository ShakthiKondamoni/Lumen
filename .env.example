# Lumen local configuration — copy to .env and adjust if needed.
# All values have safe defaults; the app runs without editing anything here.

# Where Lumen keeps its SQLite database, uploaded files, key material and exports.
LUMEN_DATA_DIR=./data

# Local API port (loopback only — never exposed to other machines).
LUMEN_PORT=8687

# Local web port used by the dev server and the preview server.
LUMEN_WEB_PORT=5173

# log level: debug | info | warn | error
LOG_LEVEL=info
